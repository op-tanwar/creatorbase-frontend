# ==============================================================================
# CreatorBase Frontend (Next.js 16) - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API URL CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development:
# Points to local Express server running on port 5000 (when developing locally)
# NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Production (Vercel / Production Deployments):
# Must point to the live Render HTTPS backend URL.
# NEVER use localhost in production to avoid Chrome Private Network Access warnings.
NEXT_PUBLIC_API_URL="https://creatorbase-backend-v1qa.onrender.com/api"

# ------------------------------------------------------------------------------
# 2. APPLICATION WEB ORIGIN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://creatorbase-one.vercel.app"

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_T6otnU3qyj7c43"

# ------------------------------------------------------------------------------
# 4. VERCEL DASHBOARD CONFIGURATION (https://vercel.com)
# ------------------------------------------------------------------------------
# In Vercel Project Settings -> Environment Variables, configure:
#   NEXT_PUBLIC_API_URL = "https://creatorbase-backend-v1qa.onrender.com/api"
#   NEXT_PUBLIC_APP_URL = "https://creatorbase-one.vercel.app"
#   NEXT_PUBLIC_RAZORPAY_KEY_ID = "rzp_test_T6otnU3qyj7c43"
